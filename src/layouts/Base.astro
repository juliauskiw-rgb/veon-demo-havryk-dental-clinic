---
import "../styles/tokens.css";
import "../styles/global.css";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" data-rec="R-010" />
    <title>{title}</title>
    <meta name="description" content={description} data-rec="SEO-R04" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#79A7B7" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link data-rec="R-014" rel="preload" href="/fonts/ysabeau-infant-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/mulish-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body id="top" data-rec="R-012,SEO-R01">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main" data-rec="R-008,M-R006"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>

<style is:global>
  html { overflow-x: clip; }
  body { overflow-x: clip; }
</style>

