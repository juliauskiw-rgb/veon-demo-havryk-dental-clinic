---
// 390: bottom bar "Подзвонити / Адреси" after the first screen (motion #4). Page gets bottom padding for it.
import PhoneIcon from "./PhoneIcon.astro";
import { phoneMain } from "../data/clinic";
---
<div class="mobile-bar" data-rec="R-002,M-R001">
  <a class="btn btn--primary mobile-bar__call" href={`tel:${phoneMain.tel}`}><PhoneIcon /><span>Подзвонити</span></a>
  <a class="btn mobile-bar__addr" href="#contacts">Адреси</a>
</div>

<style>
  .mobile-bar { position: fixed; inset: auto 0 0 0; z-index: 40; display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--s-1); padding: .625rem var(--space) calc(.625rem + env(safe-area-inset-bottom)); background: var(--color-bg); border-top: 1px solid var(--color-tint); transition: transform 250ms var(--ease-out); }
  .mobile-bar :global(.btn) { min-height: 48px; padding-inline: 1rem; }
  .mobile-bar__addr { background: var(--color-bg); border-color: var(--color-text); color: var(--color-text); }
  .mobile-bar__addr:hover { background: var(--color-calm); }
  :global(.js) .mobile-bar:not(.is-shown) { transform: translateY(110%); }
  :global(body) { padding-bottom: 76px; }
  @media (min-width: 64rem) {
    .mobile-bar { display: none; }
    :global(body) { padding-bottom: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .mobile-bar { transition: none; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>(".mobile-bar");
  const hero = document.getElementById("hero");
  if (bar && hero && "IntersectionObserver" in window) {
    new IntersectionObserver(([e]) => bar.classList.toggle("is-shown", !e.isIntersecting), { threshold: 0 }).observe(hero);
  } else if (bar) {
    bar.classList.add("is-shown");
  }
</script>
